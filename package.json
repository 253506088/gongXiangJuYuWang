{
  "name": "linkwave",
  "version": "1.3.0",
  "description": "邻波 LinkWave — 局域网文件互传与影音共享",
  "private": true,
  "main": "server/index.js",
  "bin": "server/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --no-open",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "mime-types": "^2.1.35",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": { "@yao-pkg/pkg": "^6.14.0" },
  "overrides": { "glob": "^14.0.6", "minimatch": "^11.0.9" },
  "pkg": {
    "assets": ["public/**/*", "node_modules/mime-db/db.json", "server/picker/LinkWavePicker.exe"],
    "scripts": ["server/**/*.js"],
    "outputPath": "dist"
  }
}
